# Configuración de Base de Datos
DB_HOST=127.0.0.1          # Host de la base de datos MariaDB
DB_PORT=3306               # Puerto de la base de datos
DB_NAME=salitre            # Nombre de la base de datos
DB_USER=root               # Usuario de la base de datos
DB_PASS=                   # Contraseña del usuario

# Configuración de la Aplicación
APP_ENV=local              # Entorno de ejecución (local, testing, production)
APP_URL=http://localhost   # URL base de la aplicación
APP_DEBUG=true             # Activar o desactivar modo depuración
